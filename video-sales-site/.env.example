# Database (PostgreSQL). Locally you can point this at a free Neon/Supabase
# instance, or Vercel Postgres in production (Vercel injects this automatically
# once you attach a Postgres storage resource to the project).
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PayPal (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
