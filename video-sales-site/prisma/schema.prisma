generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role/PlanInterval/SubscriptionStatus/PurchaseStatus are plain strings
// (not native enums) so the schema stays portable; validity is enforced in
// application code (src/lib, zod schemas).

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("USER")
  createdAt     DateTime       @default(now())
  purchases     Purchase[]
  subscriptions Subscription[]

  // Reseller (修了生) program — Phase 1: resells the platform's own catalog
  // via Stripe Connect Direct Charges, keeping a share of each sale.
  isReseller               Boolean    @default(false)
  resellerSlug             String?    @unique
  stripeAccountId          String?
  stripeOnboardingComplete Boolean    @default(false)
  businessName             String?
  businessAddress          String?
  businessPhone            String?
  businessEmail            String?
  resellerSales            Purchase[] @relation("ResellerSales")
}

model Video {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  description     String
  category        String
  level           String
  durationMinutes Int
  priceJpy        Int
  gradientFrom    String     @default("#81D8D0")
  gradientTo      String     @default("#FFD2D9")
  videoUrl        String
  previewUrl      String?
  membersOnly     Boolean    @default(false)
  published       Boolean    @default(true)
  createdAt       DateTime   @default(now())
  purchases       Purchase[]
}

model Plan {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  priceJpy      Int
  interval      String
  description   String
  features      String
  subscriptions Subscription[]
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id])
  amountJpy   Int
  provider    String
  providerRef String?
  status      String   @default("PAID")
  createdAt   DateTime @default(now())

  // Set when the purchase was made through a reseller's referral link.
  // The reseller received (amountJpy - applicationFeeJpy) directly in their
  // own Stripe account via a Direct Charge; applicationFeeJpy is the
  // platform's cut, collected automatically at the time of the charge.
  resellerId        String?
  reseller          User?   @relation("ResellerSales", fields: [resellerId], references: [id])
  applicationFeeJpy Int?

  @@unique([userId, videoId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  status           String    @default("ACTIVE")
  provider         String
  providerRef      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
}
