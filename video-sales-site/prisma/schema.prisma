generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role/PlanInterval/SubscriptionStatus/PurchaseStatus are plain strings
// (not native enums) so the schema stays portable; validity is enforced in
// application code (src/lib, zod schemas).

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("USER")
  createdAt     DateTime       @default(now())
  purchases     Purchase[]
  subscriptions Subscription[]

  // Reseller (修了生) program — Phase 1: resells the platform's own catalog
  // via Stripe Connect Direct Charges, keeping a share of each sale.
  isReseller               Boolean    @default(false)
  resellerSlug             String?    @unique
  stripeAccountId          String?
  stripeOnboardingComplete Boolean    @default(false)
  businessName             String?
  businessAddress          String?
  businessPhone            String?
  businessEmail            String?
  resellerSales            Purchase[] @relation("ResellerSales")

  passwordResetTokens PasswordResetToken[]
  lessonBookings      LessonBooking[]
  testimonials        Testimonial[]
  videoViews          VideoView[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Video {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  description       String
  category          String
  level             String
  durationMinutes   Int
  priceJpy          Int
  gradientFrom      String        @default("#81D8D0")
  gradientTo        String        @default("#FFD2D9")
  thumbnailUrl      String?
  thumbnailPosition String        @default("50% 50%")
  videoUrl          String
  previewUrl        String?
  membersOnly       Boolean       @default(false)
  published         Boolean       @default(true)
  createdAt         DateTime      @default(now())
  purchases         Purchase[]
  testimonials      Testimonial[]
  views             VideoView[]
}

// Records the first time a user opened a video's watch page — used only to
// gate the マイページ review prompt on "actually watched" (rather than just
// purchased/accessible), see /watch/[slug] and the dashboard review list.
model VideoView {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  videoId  String
  video    Video    @relation(fields: [videoId], references: [id])
  viewedAt DateTime @default(now())

  @@unique([userId, videoId])
}

model Plan {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  priceJpy      Int
  interval      String
  description   String
  features      String
  subscriptions Subscription[]
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id])
  amountJpy   Int
  provider    String
  providerRef String?
  status      String   @default("PAID")
  createdAt   DateTime @default(now())

  // Set when the purchase was made through a reseller's referral link.
  // The reseller received (amountJpy - applicationFeeJpy) directly in their
  // own Stripe account via a Direct Charge; applicationFeeJpy is the
  // platform's cut, collected automatically at the time of the charge.
  resellerId        String?
  reseller          User?   @relation("ResellerSales", fields: [resellerId], references: [id])
  applicationFeeJpy Int?

  @@unique([userId, videoId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  status           String    @default("ACTIVE")
  provider         String
  providerRef      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
}

// A visitor/student-submitted message via the public お問い合わせ form (see
// /contact and /api/inquiries). Stored so it's visible in /admin/inquiries;
// a copy is also emailed to every ADMIN-role user and an auto-reply is
// emailed back to the submitter, quoting their message.
model Inquiry {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime  @default(now())
  // Set automatically the first time an admin opens the detail page.
  readAt    DateTime?
  // Set manually via the "対応済みにする" button — there's no way to detect
  // an actual reply, since it happens over regular email, not in-app.
  repliedAt DateTime?
}

// Single-row table for site-wide toggles and content. lessonsEnabled shows
// or hides the レッスン予約 (lesson booking + calendar) feature without a
// redeploy — see src/lib/plan.ts. Also carries the homepage instructor
// profile, shown only once instructorName is set.
model SiteSettings {
  id                      String  @id @default("singleton")
  lessonsEnabled          Boolean @default(true)
  instructorName          String?
  instructorBio           String?
  instructorPhotoUrl      String?
  instructorPhotoPosition String  @default("50% 50%")
  // Manual override for the homepage announcement banner. When disabled (the
  // default), the banner instead auto-shows the newest published video or
  // lesson — see src/lib/announcement.ts.
  announcementEnabled     Boolean @default(false)
  announcementText        String?
  announcementUrl         String?
  // Editable homepage/footer copy — each falls back to the default copy
  // hardcoded in page.tsx/Footer.tsx when unset. マイページ's label is
  // intentionally not editable — it's always the hardcoded "マイページ".
  heroHeadline            String?
  heroCatchcopy           String?
  footerIntro             String?
}

// Snapshot of SiteSettings' four editable copy fields taken right before
// each overwrite (from PUT /api/admin/settings/copy and the restore route),
// so a save can be undone from /admin/settings even when the site owner
// wants to go back further than just the hardcoded default (SiteCopyForm's
// per-field "元の文言に戻す" already covers that simpler case).
model SiteCopyHistory {
  id            String   @id @default(cuid())
  heroHeadline  String?
  heroCatchcopy String?
  footerIntro   String?
  createdAt     DateTime @default(now())
}

// Admin-managed outbound links (blog, Instagram, X, etc.) shown quietly in
// the footer as an icon only — the platform is detected from the URL, see
// src/components/SocialIcon.tsx. Order shown is createdAt ascending.
model FooterLink {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())
}

// Social-proof testimonials — only published ones are shown. A testimonial
// with neither videoId nor lessonId set appears on the homepage; one linked
// to a specific video or lesson appears only on that item's detail page
// instead. A section is hidden entirely wherever there are none to show.
// userId is set when a student submitted it themselves (via the course/lesson
// detail page, gated on having purchased/booked it); those default to
// published: false until an admin reviews and publishes them. Admin-created
// testimonials have no userId and default to published: true.
model Testimonial {
  id            String   @id @default(cuid())
  studentName   String
  comment       String
  photoUrl      String?
  photoPosition String   @default("50% 50%")
  rating        Int?
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  videoId       String?
  video         Video?   @relation(fields: [videoId], references: [id])
  lessonId      String?
  lesson        Lesson?  @relation(fields: [lessonId], references: [id])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])

  // Only meaningful for student self-submissions (userId set) — whether they
  // checked the "publish this" consent box. Not required to submit, since an
  // unpublished answer is still useful as internal feedback. The admin
  // approval UI must not let published be set true without this being true.
  consentToPublish Boolean @default(false)
}

// Lesson booking system (Pro-plan feature) — Phase 1: manual slot creation,
// pay-per-booking via Stripe. An active member skips payment entirely (same
// bypass as video access); membersOnly additionally blocks non-members from
// booking at all, regardless of price. Recurring schedules, waitlists, and
// ticket packs are later phases.
model Lesson {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  description       String
  format            String // ONLINE | OFFLINE | HYBRID
  location          String?
  onlineUrl         String?
  durationMinutes   Int
  capacity          Int
  priceJpy          Int
  gradientFrom      String        @default("#81D8D0")
  gradientTo        String        @default("#FFD2D9")
  thumbnailUrl      String?
  thumbnailPosition String        @default("50% 50%")
  membersOnly       Boolean       @default(false)
  published         Boolean       @default(true)
  createdAt         DateTime      @default(now())
  slots             LessonSlot[]
  testimonials      Testimonial[]
}

model LessonSlot {
  id               String          @id @default(cuid())
  lessonId         String
  lesson           Lesson          @relation(fields: [lessonId], references: [id])
  startAt          DateTime
  capacityOverride Int?
  status           String          @default("OPEN") // OPEN | CANCELLED
  createdAt        DateTime        @default(now())
  bookings         LessonBooking[]
}

model LessonBooking {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  lessonSlotId String
  lessonSlot   LessonSlot @relation(fields: [lessonSlotId], references: [id])
  status       String     @default("CONFIRMED") // CONFIRMED | PENDING | CANCELLED
  amountJpy    Int
  provider     String
  providerRef  String?
  createdAt    DateTime   @default(now())

  // Only set for ¥0 bookings, which skip Stripe and confirm via emailed
  // link instead (see /lessons/confirm). A PENDING booking still counts
  // toward the slot's capacity so two people can't claim the same free
  // spot while one of them hasn't confirmed yet.
  confirmation LessonBookingConfirmation?

  @@unique([userId, lessonSlotId])
}

model LessonBookingConfirmation {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   LessonBooking @relation(fields: [bookingId], references: [id])
  token     String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}
