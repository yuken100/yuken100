generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role/PlanInterval/SubscriptionStatus/PurchaseStatus are plain strings
// (not native enums) so the schema stays portable; validity is enforced in
// application code (src/lib, zod schemas).

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("USER")
  createdAt     DateTime       @default(now())
  purchases     Purchase[]
  subscriptions Subscription[]

  // Reseller (修了生) program — Phase 1: resells the platform's own catalog
  // via Stripe Connect Direct Charges, keeping a share of each sale.
  isReseller               Boolean    @default(false)
  resellerSlug             String?    @unique
  stripeAccountId          String?
  stripeOnboardingComplete Boolean    @default(false)
  businessName             String?
  businessAddress          String?
  businessPhone            String?
  businessEmail            String?
  resellerSales            Purchase[] @relation("ResellerSales")

  passwordResetTokens PasswordResetToken[]
  lessonBookings      LessonBooking[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Video {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  description     String
  category        String
  level           String
  durationMinutes Int
  priceJpy        Int
  gradientFrom    String     @default("#81D8D0")
  gradientTo      String     @default("#FFD2D9")
  thumbnailUrl    String?
  videoUrl        String
  previewUrl      String?
  membersOnly     Boolean    @default(false)
  published       Boolean    @default(true)
  createdAt       DateTime   @default(now())
  purchases       Purchase[]
}

model Plan {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  priceJpy      Int
  interval      String
  description   String
  features      String
  subscriptions Subscription[]
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id])
  amountJpy   Int
  provider    String
  providerRef String?
  status      String   @default("PAID")
  createdAt   DateTime @default(now())

  // Set when the purchase was made through a reseller's referral link.
  // The reseller received (amountJpy - applicationFeeJpy) directly in their
  // own Stripe account via a Direct Charge; applicationFeeJpy is the
  // platform's cut, collected automatically at the time of the charge.
  resellerId        String?
  reseller          User?   @relation("ResellerSales", fields: [resellerId], references: [id])
  applicationFeeJpy Int?

  @@unique([userId, videoId])
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  status           String    @default("ACTIVE")
  provider         String
  providerRef      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
}

// Single-row table controlling which paid tier of the product this
// deployment is licensed at ("BASIC" | "PRO"). Lets the same codebase be
// delivered to different clients with features gated behind a plan, without
// a redeploy — see src/lib/plan.ts. Also carries the homepage instructor
// profile, shown only once instructorName is set.
model SiteSettings {
  id                 String  @id @default("singleton")
  plan               String  @default("PRO")
  instructorName     String?
  instructorBio      String?
  instructorPhotoUrl String?
}

// Homepage social-proof section — only published testimonials are shown,
// and the section itself is hidden entirely if there are none yet.
model Testimonial {
  id          String   @id @default(cuid())
  studentName String
  comment     String
  photoUrl    String?
  rating      Int?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Lesson booking system (Pro-plan feature) — Phase 1: manual slot creation,
// pay-per-booking via Stripe. Recurring schedules, waitlists, ticket packs,
// and subscription-included bookings are later phases.
model Lesson {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  description     String
  format          String // ONLINE | OFFLINE | HYBRID
  location        String?
  onlineUrl       String?
  durationMinutes Int
  capacity        Int
  priceJpy        Int
  gradientFrom    String       @default("#81D8D0")
  gradientTo      String       @default("#FFD2D9")
  thumbnailUrl    String?
  published       Boolean      @default(true)
  createdAt       DateTime     @default(now())
  slots           LessonSlot[]
}

model LessonSlot {
  id               String          @id @default(cuid())
  lessonId         String
  lesson           Lesson          @relation(fields: [lessonId], references: [id])
  startAt          DateTime
  capacityOverride Int?
  status           String          @default("OPEN") // OPEN | CANCELLED
  createdAt        DateTime        @default(now())
  bookings         LessonBooking[]
}

model LessonBooking {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  lessonSlotId String
  lessonSlot   LessonSlot @relation(fields: [lessonSlotId], references: [id])
  status       String     @default("CONFIRMED") // CONFIRMED | PENDING | CANCELLED
  amountJpy    Int
  provider     String
  providerRef  String?
  createdAt    DateTime   @default(now())

  // Only set for ¥0 bookings, which skip Stripe and confirm via emailed
  // link instead (see /lessons/confirm). A PENDING booking still counts
  // toward the slot's capacity so two people can't claim the same free
  // spot while one of them hasn't confirmed yet.
  confirmation LessonBookingConfirmation?

  @@unique([userId, lessonSlotId])
}

model LessonBookingConfirmation {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   LessonBooking @relation(fields: [bookingId], references: [id])
  token     String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}
